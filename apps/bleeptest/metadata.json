{
  "id": "bleeptest",
  "name": "Bleep Test",
  "shortName": "Bleep Test",
  "version": "0.02",
  "description": "Multistage fitness (bleep / beep) test on a 20m or 15m course, with vibration cues, a clock widget while it runs, and heart rate logging you can export as TCX or CSV.",
  "icon": "app.png",
  "type": "app",
  "tags": "health,sport,fitness,hrm,widget",
  "supports": [
    "BANGLEJS",
    "BANGLEJS2"
  ],
  "readme": "README.md",
  "interface": "interface.html",
  "allow_emulator": true,
  "storage": [
    {
      "name": "bleeptest.app.js",
      "url": "app.js"
    },
    {
      "name": "bleeptest",
      "url": "lib.js"
    },
    {
      "name": "bleeptest.boot.js",
      "url": "boot.js"
    },
    {
      "name": "bleeptest.wid.js",
      "url": "widget.js"
    },
    {
      "name": "bleeptest.img",
      "url": "app-icon.js",
      "evaluate": true
    }
  ],
  "data": [
    {
      "name": "bleep.json"
    },
    {
      "name": "bleeptest.settings.json"
    },
    {
      "name": "bleeptest.state.json"
    },
    {
      "wildcard": "bleep.*.csv",
      "storageFile": true
    }
  ],
  "screenshots": [
    {
      "url": "screenshot-ready.png"
    },
    {
      "url": "screenshot-running.png"
    },
    {
      "url": "screenshot-widget.png"
    }
  ]
}
