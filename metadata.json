{
  "id": "beeptest",
  "name": "Beep Test",
  "shortName": "Beep Test",
  "version": "0.05",
  "description": "Multistage fitness (beep / beep) test on a 20m or 15m course, with vibration cues, a clock widget while it runs, and heart rate logging you can export as TCX or CSV, or sync with the Beep Test Android app.",
  "icon": "app.png",
  "screenshots": [
    { "url": "screenshots/1-start.png" },
    { "url": "screenshots/2-menu.png" },
    { "url": "screenshots/3-running.png" },
    { "url": "screenshots/4-test-menu.png" },
    { "url": "screenshots/5-clock-widget.png" },
    { "url": "screenshots/6-result.png" }
  ],
  "type": "app",
  "tags": "health,sport,fitness,hrm,widget",
  "supports": ["BANGLEJS2"],
  "readme": "README.md",
  "author": "cbishopvelti",
  "interface": "interface.html",
  "allow_emulator": true,
  "storage": [
    { "name": "beeptest.app.js", "url": "app.js" },
    { "name": "beeptest.img", "url": "app-icon.js", "evaluate": true },
    { "name": "beeptest", "url": "lib.js" },
    { "name": "beeptest.boot.js", "url": "boot.js" },
    { "name": "beeptest.sync", "url": "sync.js" },
    { "name": "beeptest.wid.js", "url": "widget.js" }
  ],
  "data": [
    { "name": "beeptest.json" },
    { "name": "beeptest.settings.json" },
    { "name": "beeptest.state.json" },
    { "name": "beeptest.sync.json" },
    { "wildcard": "beeptest.*.csv", "storageFile": true }
  ]
}
